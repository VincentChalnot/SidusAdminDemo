{#
    The demo layout: the Bulma 1 layout of Sidus/AdminBundle (flash messages, <main>), plus the navbar, the footer and
    the stylesheets. It is the `base_template` of the admin (config/packages/admin.yaml): every admin action extends it,
    as do the demo pages.
#}
{% extends '@SidusAdmin/theme/bulma_1/base.html.twig' %}

{% block title %}Sidus/AdminBundle Demo{% endblock %}

{% block stylesheets %}
    <link rel="icon" href="data:,">
    {# Renders the importmap-managed Bulma <link> (imported from assets/app.js): it MUST come before app.css so the overrides win. #}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {# FontAwesome stays on the CDN: AssetMapper cannot download its webfonts (importmap:require only fetches JS/CSS). Pinned + SRI. #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css"
          integrity="sha384-nRgPTkuX86pH8yjPJUAFuASXQSSl2/bBUiNV47vSYpKFxHJhbcrGnmlYpYJMeD7a"
          crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
    <nav class="navbar is-light" role="navigation" aria-label="main navigation">
        <div class="container">
            <div class="navbar-brand">
                <a class="navbar-item has-text-weight-bold" href="{{ path('app_home') }}">
                    <span class="icon"><i class="fas fa-shield-halved"></i></span>
                    <span>&nbsp;Sidus/AdminBundle</span>
                </a>

                <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false"
                   data-target="main-navbar">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </a>
            </div>

            <div id="main-navbar" class="navbar-menu">
                <div class="navbar-start">
                    <a class="navbar-item" href="{{ path('app_home') }}">Home</a>
                    <a class="navbar-item" href="{{ admin_path('News', 'list') }}">
                        <span class="icon"><i class="fas fa-address-book"></i></span>
                        <span>&nbsp;News</span>
                    </a>
                </div>

                <div class="navbar-end">
                    <div class="navbar-item">
                        <a class="button is-dark" href="https://github.com/VincentChalnot/SidusAdminDemo">
                            <span class="icon"><i class="fab fa-github"></i></span>
                            <span>Fork me on GitHub</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    {# The flash messages and the <main> of the bundle layout #}
    {{ parent() }}

    <footer class="footer">
        <div class="container">
            <div class="content has-text-centered">
                <p>
                    <strong>Sidus/AdminBundle Demo</strong> &mdash; built with
                    <a href="https://symfony.com">Symfony</a>,
                    <a href="https://github.com/VincentChalnot/SidusAdminBundle">Sidus/AdminBundle</a> and
                    <a href="https://bulma.io">Bulma</a>.
                </p>
            </div>
        </div>
    </footer>
{% endblock %}

{# Wider than Bulma's default container, see assets/styles/app.css #}
{% block main %}
    <main class="section">
        <div class="container is-wide">
            {{ block('container') }}
        </div>
    </main>
{% endblock %}
